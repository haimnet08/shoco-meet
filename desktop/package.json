{
  "name": "shoco-meet-desktop",
  "version": "1.0.10",
  "description": "Shoco Meet desktop app – share screen and allow remote control (with consent)",
  "main": "main.js",
  "author": "haimnet08",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.haimnet08.shocomeet",
    "productName": "Shoco Meet",
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../web", "to": "web" }],
    "artifactName": "Shoco-Meet-${os}.${ext}",
    "protocols": [{ "name": "Shoco Meet", "schemes": ["shocomeet"] }],
    "publish": [{ "provider": "github", "owner": "haimnet08", "repo": "shoco-meet", "releaseType": "release" }],
    "win": { "target": "nsis" },
    "appx": { "applicationId": "ShocoMeet", "displayName": "Shoco Meet", "languages": ["he-IL", "en-US"], "backgroundColor": "#1e3a8a",
      "capabilities": ["runFullTrust", "internetClient", "internetClientServer", "privateNetworkClientServer", "webcam", "microphone"] },
    "mac": { "target": "dmg", "category": "public.app-category.business" },
    "linux": { "target": "AppImage", "category": "Network" }
  }
}
